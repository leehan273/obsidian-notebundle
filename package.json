{
    "name": "obsidian-notebundle",
    "version": "0.9.0",
    "description": "Obsidian plugin to support Notebundle (.notebundle) natively.",
    "private": true,
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check": "npm run lint && npm run format:check && npm run build"
    },
    "keywords": [],
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^22.15.17",
        "esbuild": "0.25.5",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.5.1",
        "globals": "^17.6.0",
        "jiti": "^2.6.1",
        "obsidian": "1.14.4",
        "prettier": "3.9.6",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.59.1"
    },
    "dependencies": {
        "monkey-around": "3.0.0"
    }
}
